{
  "name": "talenox-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP tools for reading and modifying HR and payroll records through the Talenox v2 API",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "talenox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "mcp-config.example.json"
  ],
  "repository": {
    "url": "git+https://github.com/deanchong/talenox-mcp.git",
    "type": "git"
  }
}
